; Add as a dedicated pool to the system PHP-FPM configuration.
; Create the blog service user/group first; adapt nginx's group on FreeBSD.
[blog]
user = blog
group = blog
listen = /run/php-fpm-blog.sock
listen.owner = blog
listen.group = nginx
listen.mode = 0660
pm = ondemand
pm.max_children = 4
pm.process_idle_timeout = 10s
pm.max_requests = 500
clear_env = yes
security.limit_extensions = .php
; Keep all secrets/configuration outside public/.
env[BLOG_CONFIG] = /etc/blog/config.php
php_admin_value[post_max_size] = 256K
php_admin_value[upload_max_filesize] = 256K
php_admin_value[max_input_vars] = 30
php_admin_value[memory_limit] = 128M
php_admin_value[max_execution_time] = 30
php_admin_flag[file_uploads] = off
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[session.gc_probability] = 1
php_admin_value[session.gc_divisor] = 100
php_admin_flag[opcache.enable] = on
php_admin_value[opcache.memory_consumption] = 64
php_admin_value[opcache.validate_timestamps] = 1
