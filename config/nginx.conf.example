# Include inside nginx's http {}. Replace hostname, certificates, root and socket.
# The only web-accessible directory is public/.
server {
    listen 80;
    server_name blogs.example.com;
    return 308 https://blogs.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name blogs.example.com;
    ssl_certificate /etc/ssl/blogs/fullchain.pem;
    ssl_certificate_key /etc/ssl/blogs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/blog/public;
    client_max_body_size 256k;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /assets/base.css {
        types { text/css css; }
        expires 1h;
        add_header X-Content-Type-Options nosniff always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /assets/blog.css {
        types { text/css css; }
        expires 1h;
        add_header X-Content-Type-Options nosniff always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location ~ /\. { return 404; }
    location ~ \.php(?:/|$) { return 404; }
    location / { rewrite ^ /index.php last; }
    location = /index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php-fpm-blog.sock;
        fastcgi_read_timeout 30s;
        fastcgi_cache off;
    }
}
